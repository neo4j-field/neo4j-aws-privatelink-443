<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="Neo4j - Bolt HAProxy vs Direct Performance Test" enabled="true">
      <stringProp name="TestPlan.comments">Compares real Bolt-protocol query latency reached directly on Neo4j's native Bolt port (7687, HAProxy bypassed, public internet) vs via HAProxy on 443 (magic-byte demux to loopback :7687), over the existing PrivateLink path. JMeter has no native Bolt sampler, so each request uses a JSR223 (Groovy) Sampler backed by the official Neo4j Java driver -- this exercises the real wire protocol (handshake, TLS, PackStream) instead of hand-rolled bytes. Requires neo4j-java-driver (+ reactive-streams) on JMeter's classpath -- see README.md. All variables below are overridable from the command line with -JNAME=value.</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
        <collectionProp name="Arguments.arguments">
          <elementProp name="DIRECT_HOST" elementType="Argument">
            <stringProp name="Argument.name">DIRECT_HOST</stringProp>
            <stringProp name="Argument.value">${__P(DIRECT_HOST,3.235.109.212)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="DIRECT_PORT" elementType="Argument">
            <stringProp name="Argument.name">DIRECT_PORT</stringProp>
            <stringProp name="Argument.value">${__P(DIRECT_PORT,7687)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="VIA_HAPROXY_HOST" elementType="Argument">
            <stringProp name="Argument.name">VIA_HAPROXY_HOST</stringProp>
            <stringProp name="Argument.value">${__P(VIA_HAPROXY_HOST,privatelink.neo4jfield.org)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="VIA_HAPROXY_PORT" elementType="Argument">
            <stringProp name="Argument.name">VIA_HAPROXY_PORT</stringProp>
            <stringProp name="Argument.value">${__P(VIA_HAPROXY_PORT,443)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="NEO4J_DATABASE" elementType="Argument">
            <stringProp name="Argument.name">NEO4J_DATABASE</stringProp>
            <stringProp name="Argument.value">${__P(NEO4J_DATABASE,neo4j)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="NEO4J_USER" elementType="Argument">
            <stringProp name="Argument.name">NEO4J_USER</stringProp>
            <stringProp name="Argument.value">${__P(NEO4J_USER,neo4j)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="NEO4J_PASSWORD" elementType="Argument">
            <stringProp name="Argument.name">NEO4J_PASSWORD</stringProp>
            <stringProp name="Argument.value">${__P(NEO4J_PASSWORD,CHANGE_ME)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="CYPHER_STATEMENT" elementType="Argument">
            <stringProp name="Argument.name">CYPHER_STATEMENT</stringProp>
            <stringProp name="Argument.value">${__P(CYPHER_STATEMENT,MATCH (p:PerfTestPerson {id: $id}) RETURN p.id AS id\, p.name AS name\, p.email AS email\, p.city AS city)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="SEED_MAX_ID" elementType="Argument">
            <stringProp name="Argument.name">SEED_MAX_ID</stringProp>
            <stringProp name="Argument.value">${__P(SEED_MAX_ID,10000)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="CONNECT_TIMEOUT_SEC" elementType="Argument">
            <stringProp name="Argument.name">CONNECT_TIMEOUT_SEC</stringProp>
            <stringProp name="Argument.value">${__P(CONNECT_TIMEOUT_SEC,5)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="THREADS" elementType="Argument">
            <stringProp name="Argument.name">THREADS</stringProp>
            <stringProp name="Argument.value">${__P(THREADS,10)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="RAMPUP" elementType="Argument">
            <stringProp name="Argument.name">RAMPUP</stringProp>
            <stringProp name="Argument.value">${__P(RAMPUP,5)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="LOOPS" elementType="Argument">
            <stringProp name="Argument.name">LOOPS</stringProp>
            <stringProp name="Argument.value">${__P(LOOPS,50)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="WARMUP_THREADS" elementType="Argument">
            <stringProp name="Argument.name">WARMUP_THREADS</stringProp>
            <stringProp name="Argument.value">${__P(WARMUP_THREADS,5)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="WARMUP_LOOPS" elementType="Argument">
            <stringProp name="Argument.name">WARMUP_LOOPS</stringProp>
            <stringProp name="Argument.value">${__P(WARMUP_LOOPS,20)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </elementProp>
      <stringProp name="TestPlan.user_define_classpath"></stringProp>
    </TestPlan>
    <hashTree>

      <!-- ============================================================ -->
      <!-- Setup Thread Group: Warm-up (runs first, always; not counted  -->
      <!-- in results, since no listener is attached to this group).    -->
      <!-- Warms JIT/connection-pool/page-cache before measured groups. -->
      <!-- ============================================================ -->
      <SetupThreadGroup guiclass="SetupThreadGroupGui" testclass="SetupThreadGroup" testname="00 - Warm-up (untracked)" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">${WARMUP_LOOPS}</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">${WARMUP_THREADS}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">1</stringProp>
        <boolProp name="ThreadGroup.scheduler">false</boolProp>
        <stringProp name="ThreadGroup.duration"></stringProp>
        <stringProp name="ThreadGroup.delay"></stringProp>
      </SetupThreadGroup>
      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Warm-up - Direct (Bolt 7687)" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script"><![CDATA[
import org.neo4j.driver.AuthTokens
import org.neo4j.driver.GraphDatabase
import org.neo4j.driver.Driver
import org.neo4j.driver.Session
import org.neo4j.driver.SessionConfig
import org.neo4j.driver.Config
import java.util.concurrent.TimeUnit

String host = vars.get("DIRECT_HOST")
String port = vars.get("DIRECT_PORT")
String uri  = "bolt+ssc://" + host + ":" + port
String user = vars.get("NEO4J_USER")
String pass = vars.get("NEO4J_PASSWORD")
String database = vars.get("NEO4J_DATABASE")
String cypher = vars.get("CYPHER_STATEMENT")
int maxId = vars.get("SEED_MAX_ID").toInteger()
int connectTimeoutSec = vars.get("CONNECT_TIMEOUT_SEC").toInteger()
int id = new Random().nextInt(maxId) + 1

String driverKey = "neo4j_driver::" + uri
Driver driver = (Driver) props.get(driverKey)
if (driver == null) {
    synchronized (props) {
        driver = (Driver) props.get(driverKey)
        if (driver == null) {
            Config cfg = Config.builder().withConnectionTimeout(connectTimeoutSec, TimeUnit.SECONDS).build()
            driver = GraphDatabase.driver(uri, AuthTokens.basic(user, pass), cfg)
            props.put(driverKey, driver)
            log.info("Created Bolt driver for " + uri)
        }
    }
}

try {
    Session session = driver.session(SessionConfig.forDatabase(database))
    try {
        def records = session.run(cypher, [id: id]).list()
        SampleResult.setResponseData("rows=" + records.size(), "UTF-8")
        SampleResult.setSuccessful(true)
        SampleResult.setResponseCodeOK()
        SampleResult.setResponseMessage("OK")
    } finally {
        session.close()
    }
} catch (Exception e) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode("500")
    SampleResult.setResponseMessage(e.toString())
    SampleResult.setResponseData(e.toString(), "UTF-8")
}
]]></stringProp>
        </JSR223Sampler>
        <hashTree/>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Warm-up - Via HAProxy (Bolt over 443)" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script"><![CDATA[
import org.neo4j.driver.AuthTokens
import org.neo4j.driver.GraphDatabase
import org.neo4j.driver.Driver
import org.neo4j.driver.Session
import org.neo4j.driver.SessionConfig
import org.neo4j.driver.Config
import java.util.concurrent.TimeUnit

String host = vars.get("VIA_HAPROXY_HOST")
String port = vars.get("VIA_HAPROXY_PORT")
String uri  = "bolt+ssc://" + host + ":" + port
String user = vars.get("NEO4J_USER")
String pass = vars.get("NEO4J_PASSWORD")
String database = vars.get("NEO4J_DATABASE")
String cypher = vars.get("CYPHER_STATEMENT")
int maxId = vars.get("SEED_MAX_ID").toInteger()
int connectTimeoutSec = vars.get("CONNECT_TIMEOUT_SEC").toInteger()
int id = new Random().nextInt(maxId) + 1

String driverKey = "neo4j_driver::" + uri
Driver driver = (Driver) props.get(driverKey)
if (driver == null) {
    synchronized (props) {
        driver = (Driver) props.get(driverKey)
        if (driver == null) {
            Config cfg = Config.builder().withConnectionTimeout(connectTimeoutSec, TimeUnit.SECONDS).build()
            driver = GraphDatabase.driver(uri, AuthTokens.basic(user, pass), cfg)
            props.put(driverKey, driver)
            log.info("Created Bolt driver for " + uri)
        }
    }
}

try {
    Session session = driver.session(SessionConfig.forDatabase(database))
    try {
        def records = session.run(cypher, [id: id]).list()
        SampleResult.setResponseData("rows=" + records.size(), "UTF-8")
        SampleResult.setSuccessful(true)
        SampleResult.setResponseCodeOK()
        SampleResult.setResponseMessage("OK")
    } finally {
        session.close()
    }
} catch (Exception e) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode("500")
    SampleResult.setResponseMessage(e.toString())
    SampleResult.setResponseData(e.toString(), "UTF-8")
}
]]></stringProp>
        </JSR223Sampler>
        <hashTree/>
      </hashTree>

      <!-- ============================================================ -->
      <!-- Thread Group 1: Baseline - Direct Bolt, HAProxy bypassed     -->
      <!-- ============================================================ -->
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="01 - Baseline (Direct Bolt 7687, HAProxy bypassed)" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true">
          <boolProp name="LoopController.continue_forever">false</boolProp>
